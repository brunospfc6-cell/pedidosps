<?xml version="1.0" encoding="utf-8"?>
<!--
  Cole este arquivo em C:\Apps\Pro-Systems\frontend\web.config
  O site IIS deste domínio deve apontar para essa pasta.
  Requer URL Rewrite + ARR com "Enable proxy" marcado no servidor.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Pro-Systems para uvicorn" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
